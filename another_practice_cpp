#include<vector>
using namespace std;

void helper(vector<vector<int>> &mat , int r,int c, string path, vector<string> &ans ){

    int n= mat.size();
    if(r<0 || c<0 || r>=n|| c>=n|| mat[r][c] ==0 || mat[r][c] == -1){ // Added check for -1 (already visited)
        return;
    }
    if(r == n-1 && c == n-1){
        ans.push_back(path);
        mat[r][c] = 1; // Corrected: Add the backtracking step here
        return;
    }
    mat[r][c] =-1; // Mark as visited

 helper(mat, r+1 ,c, path+"D",ans );
  helper(mat, r-1 ,c, path+"U",ans );
   helper(mat, r,c-1, path+"L",ans);
    helper(mat, r ,c+1, path+"R",ans );
    mat[r][c] = 1; // Mark as unvisited (backtrack)
 }

//complete this function
vector<string> findpath(vector<vector<int>> &mat) {
vector<string> ans;
string path ="";
  
// Check if source is 0
if (mat[0][0] == 0) return ans; // Added initial check

helper(mat,0,0, path , ans );
return ans;
}

int main(){
    vector<vector<int>> mat ={{1,0,0,0}, {1,1,0,1},{1,1,0,0},{0,1,1,1}};

    vector<string> ans =findpath(mat);
    for(string path :ans){
        cout<<path <<endl;
    }
